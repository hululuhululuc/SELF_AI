# .env.example - Copy to .env and fill in values

SELF_AI_USE_ASYNC=false
SELF_AI_USE_SPARSE=false
SELF_AI_USE_GPU=false
SELF_AI_USE_STRUCTURED=false
SELF_AI_PERMISSION_MODE=dev_write
SELF_AI_SHELL_ENABLED=false
SELF_AI_SHELL_ALLOWLIST=git status;git diff;python -m pytest;pytest;ruff check;mypy;streamlit run
SELF_AI_SHELL_DENYLIST=rm,del,sudo,shutdown,reboot,curl,wget,powershell,cmd,bash,sh,pip install
SELF_AI_PROMPT_CACHE_ENABLED=true
SELF_AI_PROMPT_CACHE_MAX_ENTRIES=64
# Prompt budget defaults are sized for the 202K-context GLM tier.
# For all-qwen/deepseek 1M-context deployments, this can be raised after real smoke tests.
SELF_AI_PROMPT_MAX_CHARS_MAINLOOP=180000
SELF_AI_PROMPT_DYNAMIC_BUDGET_RATIO=0.65
SELF_AI_PROMPT_RECENT_ERRORS=12
SELF_AI_PROMPT_RECENT_TOOL_RESULTS=24
SELF_AI_PROMPT_SELECTED_AGENTS_MAX=16
SELF_AI_PROMPT_TOOL_CATALOG_MAX=160
SELF_AI_CHAT_MEMORY_ENABLED=true
SELF_AI_CHAT_MEMORY_ROOT=./memory/chats
SELF_AI_CHAT_MEMORY_MAX_SHARD_BYTES=1048576
SELF_AI_CHAT_MEMORY_MAX_TURNS_PER_SHARD=200
SELF_AI_CHAT_MEMORY_RECENT_TURNS=16
SELF_AI_CHAT_MEMORY_INJECTION_MAX_CHARS=96000
SELF_AI_CHAT_MEMORY_INJECTION_ITEM_MAX_CHARS=6000
SELF_AI_CHAT_MEMORY_SIDECAR_ENABLED=true
SELF_AI_CHAT_MEMORY_SIDECAR_TIMEOUT_S=14
SELF_AI_CHAT_MEMORY_SIDECAR_RETRY_ENABLED=true
SELF_AI_CHAT_MEMORY_SIDECAR_FAST_RETRY_TIMEOUT_S=6
SELF_AI_CHAT_MEMORY_FUSION_ENABLED=true
SELF_AI_CHAT_MEMORY_L2_COLLECTION_DEFAULT=cf_chat_memory
SELF_AI_CHAT_MEMORY_COMPACT_ENABLED=true
SELF_AI_CHAT_MEMORY_COMPACT_MIN_SHARDS=3
SELF_AI_CHAT_MEMORY_COLD_AFTER_DAYS=7
SELF_AI_CHAT_MEMORY_SUMMARY_MAX_CHARS=4000
SELF_AI_CHAT_MEMORY_COMPACT_MAX_DOCS=400
QDRANT_URL=http://localhost:6333
QDRANT_TIMEOUT_S=2.0
NEO4J_URI=bolt://localhost:7687
NEO4J_ENABLED=true
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
GRAPH_READ_ENABLED=false
GRAPH_MAX_PATHS=5
GRAPH_TIMEOUT_MS=1000
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=self_ai
REDIS_DEFAULT_TTL_SECONDS=86400
REDIS_ENABLED=true
SELF_AI_EMBEDDER_PATH=./self_ai/model/bge-m3
SELF_AI_EMBEDDER_FP16=false
SELF_AI_EMBEDDER_PREWARM=false
SELF_AI_QDRANT_STRICT_SCHEMA=true
SELF_AI_DISABLE_LEGACY_RETRIEVAL=true
REDIS_HOST=localhost
SELF_AI_TRACE_SANITIZE_CONTROL=true
SELF_AI_TRACE_REPAIR_MOJIBAKE=true

# DashScope (Alibaba Bailian) OpenAI-compatible
DASHSCOPE_API_KEY=your_dashscope_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ENABLE_THINKING=true
DASHSCOPE_TIMEOUT_S=80

# Model tiers (router chooses at runtime)
SELF_AI_MODEL_FAST=qwen3.6-flash
SELF_AI_MODEL_BALANCED=qwen3.5-plus-2026-02-15
SELF_AI_MODEL_HIGH=qwen3.6-plus
SELF_AI_MODEL_CODE=kimi-k2.6

# Router selector behavior
SELF_AI_ROUTER_SELECTOR_MODEL=deepseek-v4-flash
SELF_AI_ROUTER_USE_SELECTOR=false
SELF_AI_ROUTER_DEFAULT_TIER=balanced
SELF_AI_ROUTER_DEFAULT_ENABLE_THINKING=false
SELF_AI_ROUTER_MAX_RETRIES=2

# MainLoop performance knobs
SELF_AI_MAINLOOP_GOAL_CONTRACT_MODEL_ENABLED=true
SELF_AI_MAINLOOP_GOAL_CONTRACT_VERIFY_VOTE_ENABLED=false
SELF_AI_MAINLOOP_SEMANTIC_COMPLETION_GATE_ENABLED=true
SELF_AI_MAINLOOP_SEMANTIC_GATE_SIDE_EFFECT_ONLY=true

# Optional web retrieval
TAVILY_API_KEY=
